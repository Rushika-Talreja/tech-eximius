# ============================================================
# DeFi Contract Auditor — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Core
APP_ENV=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database / queue / storage
DATABASE_URL=postgresql+asyncpg://auditor:auditor@localhost:5432/auditor
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=auditor-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
ARTIFACT_ENCRYPTION_KEY_ID=local-dev-key
DEFAULT_RETENTION_HOURS=24

# Auth
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_AUDIENCE=defi-auditor
OIDC_JWKS_URL=https://your-oidc-provider.example.com/.well-known/jwks.json
API_KEY_HASH_PEPPER=change-me-32-bytes-random-string!!

# Vector DB / embeddings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SPARSE_MODEL=Qdrant/bm25
RAG_MIN_SCORE=0.35
RAG_TOP_K=20

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL_REASONING=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini
LLM_ZERO_RETENTION=false   # must be true in staging/prod

# Sandbox
SANDBOX_RUNTIME=docker
SANDBOX_CPU_LIMIT=2
SANDBOX_MEM_LIMIT_MB=2048
SANDBOX_TIMEOUT_SECONDS=300
DEPENDENCY_FETCH_ALLOWLIST=registry.npmjs.org,github.com,codeload.github.com

# Limits
MAX_UPLOAD_MB=10
MAX_FILES_PER_AUDIT=200
AUDITS_PER_HOUR_PER_ORG=20
